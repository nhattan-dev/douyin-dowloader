# ── STT (OpenAI) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# api.openai.com hay bị chặn ở tầng mạng tại VN: TCP/TLS bắt tay xong nhưng không
# nhận được response, SDK báo "Connection error". Bật VPN, hoặc điền proxy vào đây —
# script chạy với --use-env-proxy nên Node tự dùng biến này cho mọi request.
# HTTPS_PROXY=http://127.0.0.1:1080
# Cú pháp `engine:model`; thiếu `engine:` là openai.
#   whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
#   qwen:qwen-audio-3.0-asr-flash-filetrans  — cần DASHSCOPE_API_KEY + DASHSCOPE_BASE_URL
# Giữ whisper-1 nếu cần timestamp ở phía OpenAI: chỉ whisper-1 hỗ trợ
# timestamp_granularities, các model kia rẻ hơn nhưng không có mốc thời gian.
# Qwen-ASR (filetrans) có timestamp tới từng chữ, nghe đúng chữ hơn whisper-1 rõ rệt
# trên nội dung 修真 (灵石 vs "零食", 三阶 vs 三界, 内丹 vs 内胆 — whisper sai dù đã mồi
# qua STT_PROMPT), chịu được audio dài, tính tiền theo giây CÓ TIẾNG (nội dung nhiều
# nhạc đệm rẻ hơn ~2-3 lần). Đổi lại timestamp trễ hơn whisper ~0.35s (trung vị).
# Engine qwen KHÔNG gọi STT_DIARIZE_MODEL bên dưới — nhãn người nói lấy từ QWEN_DIARIZE.
STT_MODEL=whisper-1
# Mốc thời gian cho transcript, cần cho bước căn tiếng khi dub.
# segment | word | segment,word | để trống để tắt
STT_TIMESTAMPS=segment,word
# Mồi từ vựng cho whisper (tối đa 224 token). Whisper nghe đúng âm nhưng hay chọn sai
# chữ đồng âm — liệt kê đúng mặt chữ của thuật ngữ hay gặp để kéo model về đúng.
# Ví dụ cho nội dung tiên hiệp/玄幻:
# STT_PROMPT=以下是修真玄幻小说的旁白：金丹、元婴、渡劫、法宝、下品宝剑、青锋剑、燃料、灵气、心魔、雷劫、大阵
STT_PROMPT=

# ── STT tổng thể + định danh người nói ─────────────────────────
# whisper-1 ở trên làm STT TỔNG THỂ (text + timestamp, không đổi bằng nguồn nào
# khác). Diarize CHỈ để định danh người nói qua chồng lấn thời gian — audio gốc,
# KHÔNG tách vocal (từng thử bằng Demucs, bỏ vì thành bottleneck khi chạy batch
# hàng trăm video). Tắt hẳn diarize bằng cách để trống. Phần đắt nhất: ~$5.76 cho
# 122 video.
STT_DIARIZE_MODEL=gpt-4o-transcribe-diarize
# Mồi từ vựng — hiện KHÔNG dùng trong flow chính (diarize không lấy text nữa nên
# prompt sửa mặt chữ vô nghĩa với nó). Giữ cho lệnh `compare` và
# scripts/compare-diarize-bgm.js khi cần thử nghiệm riêng.
STT_KEYWORDS=
# Gộp segment liền nhau cùng người nói thành một lượt thoại nếu cách nhau dưới ngưỡng.
SPEAKER_MERGE_MAX_GAP_SEC=1.5
# Nếu true, segment nào diarize không gán được thì để LLM suy nốt từ mạch thoại
# (đánh dấu inferred, soát bằng `npm run review-speakers`). Mặc định false: đoán
# sai giọng đọc lồng tiếng còn tệ hơn để nguyên "không xác định".
SPEAKER_INFER=false
# ISO-639-1. Douyin -> tiếng Trung
STT_LANGUAGE=zh
# Số lần SDK tự thử lại khi lỗi mạng (mặc định của SDK chỉ là 2 — quá ít với
# đường truyền chập chờn tới api.openai.com từ VN)
# Đừng để cao: request đầu nhận lỗi API thật (429/401) thì các lần retry rớt kết nối
# sẽ đè lên, chỉ còn "Connection error" và mất luôn nguyên nhân thật.
STT_MAX_RETRIES=3
STT_TIMEOUT_MS=180000
# Số video transcribe song song. Nút cổ chai là độ trễ mạng chứ không phải băng
# thông (file chỉ ~1.5MB), nên song song vài luồng nhanh hơn hẳn.
STT_CONCURRENCY=3
# Sau khi quét hết một lượt, thử lại các video còn lỗi thêm mấy lượt nữa
STT_RETRY_PASSES=4
STT_PASS_DELAY_MS=15000
# Engine cho lệnh `compare`, cú pháp `engine:model` (thiếu engine = openai).
#   openai:<model>       — whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
#   qwen:<model>         — qwen-audio-3.0-asr-flash, cần DASHSCOPE_API_KEY +
#                          DASHSCOPE_BASE_URL. CÓ timestamp tới từng chữ ngay với file
#                          local, nhưng KHÔNG tách người nói (speaker_id luôn null).
#   siliconflow:<model>  — host model ASR mã nguồn mở TQ (SenseVoice, Fun-ASR) sau đúng
#                          giao thức /audio/transcriptions của OpenAI.
STT_COMPARE_MODELS=whisper-1,gpt-4o-transcribe,qwen:qwen-audio-3.0-asr-flash
# Số điểm bất đồng in ra cho mỗi cặp engine
STT_COMPARE_MAX_DIFFS=25
# Mồi từ vựng cho engine TQ. CHƯA KIỂM CHỨNG field này được chấp nhận — để trống thì
# không gửi; điền vào mà API trả 400 là biết không hỗ trợ.
STT_CONTEXT=
SILICONFLOW_API_KEY=

# ── Dịch ──────────────────────────────────────────────────────
# Nhãn người nói đi vào SYSTEM PROMPT, mà dịch máy không có system prompt — chọn
# provider Google nghĩa là vứt toàn bộ kết quả diarize (phần đắt nhất của STT,
# $5.76/122 video) và mất xưng hô đúng. Pipeline sẽ cảnh báo chứ không im lặng.
#
# openai      : LLM 1 lượt, ổn định, ~$0.03 cho 122 video, sửa được lỗi đồng âm
#               của STT, DÙNG ĐƯỢC nhãn người nói. Mặc định.
# openai-2pass: LLM 2 lượt (nháp rồi tự biên tập lại văn phong), dùng được nhãn
#               người nói — chọn nếu thấy `openai` dịch khô. Tốn ~gấp đôi openai.
# google-web  : lái translate.google.com bằng Playwright. Dịch hay nhất khi không bị
#               bóp, nhưng Google hạ xuống model NMT đời cũ khi dùng nhiều (xem
#               README) và BỎ QUA nhãn người nói.
# google-free : endpoint translate_a/single. Miễn phí, không cần key, chất lượng kém,
#               bỏ qua nhãn người nói. Hợp để kiểm thử phần chia segment.
# deepseek    : model TQ, API tương thích OpenAI. Nắm thuật ngữ 玄幻 tốt hơn và
#               endpoint gần VN hơn (đo: TLS 0.33s vs OpenAI chập chờn). RỦI RO nằm ở
#               chiều NGƯỢC: model thạo tiếng Trung mà yếu tiếng Việt dễ quay ra phiên
#               âm Hán-Việt. Đo bằng translate-compare trước khi đổi.
# qwen        : Qwen của Alibaba qua compatible-mode của DashScope. Nhiều tiếng Việt
#               hơn DeepSeek nên là ứng viên khá hơn cho zh→vi, vẫn phải đo.
# google-2pass: Google dịch tham khảo (nguyên đoạn văn xuôi, không chia dòng) rồi
#               OpenAI tự dịch chính theo bản gốc, có tham chiếu — CHỈ để so sánh qua
#               translate-compare, không khuyến nghị làm mặc định (mất cơ chế phát
#               hiện Google tụt model, xem code comment trong google-2pass.js).
TRANSLATE_PROVIDER=openai

# Provider TQ — chỉ cần key khi thực sự dùng tới.
# DeepSeek: đăng ký ở platform.deepseek.com, nhận key quốc tế bình thường.
DEEPSEEK_API_KEY=
# Model cho lượt NHÁP (lượt 1 của deepseek-2pass). `deepseek-chat` là ALIAS cũ, không
# còn nằm trong `GET /models` (chỉ còn deepseek-v4-flash / -pro / -flash-vision-exp),
# nhưng vẫn resolve và chạy KHÔNG suy luận (~3s/cụm) — đúng thứ cần cho lượt nháp.
DEEPSEEK_MODEL=deepseek-chat
# Model cho lượt REVIEW (lượt 2 — soát nghĩa). Mặc định deepseek-v4-pro, là model CÓ
# SUY LUẬN. Đo trên cùng một bản nháp (22 dòng, 4 lỗi nghĩa soát tay): deepseek-chat
# sửa đúng 1/4 ca và chỉ đổi 1/22 dòng; deepseek-v4-pro sửa đúng 3/4 nhưng tốn 377s và
# ~21.700 token suy luận. Hạ về deepseek-chat nếu cần chạy batch gấp.
# ĐỪNG đổi sang deepseek-v4-flash: đo thật thì nó đốt sạch 32.767 token suy luận mà
# không viết ra dòng JSON nào.
TRANSLATE_REVIEW_MODEL=deepseek-v4-pro
# Trần token RIÊNG cho lượt review — token suy luận ăn chung hạn ngạch completion, hết
# quota giữa lúc đang nghĩ thì content về RỖNG và lượt review âm thầm trả lại bản cũ.
# 8192 và 18192 đều đo được là rỗng với v4-pro; 32768 mới chạy được.
TRANSLATE_REVIEW_MAX_TOKENS=32768
# Model cho lượt POLISH (lượt 3 — chỉ chữa văn phong trên bản đã đúng nghĩa).
DEEPSEEK_REVIEW_MODEL=deepseek-chat
# Alibaba DashScope. Mặc định trỏ bản QUỐC TẾ (Singapore) — đăng ký được bằng thẻ nước
# ngoài. Bản nội địa là https://dashscope.aliyuncs.com/compatible-mode/v1 nhưng thường
# đòi thực danh TQ, và key hai bên KHÔNG dùng lẫn được.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Host cho Qwen-ASR (STT_MODEL=qwen:...). KHÁC QWEN_BASE_URL ở trên và không có default
# dùng được: key cấp theo workspace thì host cũng riêng theo workspace, dùng lẫn là
# 401/404. Đừng chép tay ba dòng này — tải file apiKey CSV từ console về secret/ rồi:
#   node scripts/apikey-csv-to-env.js --write
# Chú ý model phải được bấm kích hoạt riêng trong console, chưa bật thì API trả
# 403 AccessDenied.Unpurchased.
DASHSCOPE_BASE_URL=
# Host để POLL trạng thái task filetrans — KHÁC DASHSCOPE_BASE_URL: submit lên host
# workspace được nhưng hỏi task ở đó trả 403, phải qua host vùng công khai. Mặc định
# cho Singapore; đổi thành https://dashscope.aliyuncs.com nếu workspace ở Bắc Kinh.
# DASHSCOPE_POLL_URL=https://dashscope-intl.aliyuncs.com
# Bật diarize của Qwen-ASR filetrans (trả speaker_id). Mặc định TẮT: tách khá ổn với
# lồng tiếng nhiều diễn viên (video 西游 → 8 cụm, phần lớn đúng vai), nhưng LOẠN với
# nội dung một-người-lồng-nhiều-giọng (video 修真 → 10 cụm cho 3 vai). Ép số cụm bằng
# QWEN_SPEAKER_COUNT (0 = để model tự quyết).
# QWEN_DIARIZE=false
# QWEN_SPEAKER_COUNT=0
# auto = để Google tự nhận ngôn ngữ nguồn
TRANSLATE_FROM=auto
TRANSLATE_TO=vi
# Ngôn ngữ giao diện translate.google.com (context trình duyệt để zh-CN cho Douyin)
TRANSLATE_UI_LANG=vi
TRANSLATE_MAX_CHARS=4000
# Trần cho provider LLM (openai/deepseek/qwen + bản 2pass) — TÁCH RIÊNG khỏi trần
# trên vì đó là kích thước ô nhập của Google, còn đây là sức chịu của model.
# ĐÃ ĐO: gửi 179 dòng một lượt thì deepseek-chat trả về NGUYÊN TIẾNG TRUNG (hỏng
# 100%, im lặng); cắt thành 116+63 dòng thì dịch sạch. Đừng nâng nếu chưa đo lại.
TRANSLATE_MAX_CHARS_LLM=4000
# Trần token ĐẦU RA cho các lượt gọi LLM ép JSON (provider openai/deepseek/*-2pass).
# Doc JSON Mode của DeepSeek dặn đặt đủ rộng: JSON bị cắt giữa chừng là JSON HỎNG,
# mất trắng cả cụm chứ không phải mất dòng cuối như giao thức đánh số. Mốc ước lượng:
# cụm 43 dòng / 1180 ký tự tiếng Trung tốn 784 token đầu ra.
TRANSLATE_MAX_TOKENS=18192
# Gộp segment liền mạch cùng người nói thành một đơn vị dịch. whisper cắt theo chunk
# chứ không theo câu nên hay chặt đôi giữa từ (đo được: 昨日 thành `…出事,作` + `日有…`,
# hai nửa cách nhau đúng 0.00s) — dịch rời hai dòng đó thì chắc chắn sai, không ngữ
# cảnh nào cứu được. Để CHẶT: nới lên là gộp qua cả khoảng lặng thật, TTS đọc liền
# một hơi thì tiếng dub lệch khỏi hình. Khác SPEAKER_MERGE_MAX_GAP_SEC (trường `turns`
# chỉ để đọc cho dễ) — đây là dữ liệu thật đưa sang LangDub.
TRANSLATE_MERGE_MAX_GAP_SEC=0.2
TRANSLATE_TIMEOUT_MS=45000
TRANSLATE_MODEL=gpt-4o-mini
# Model riêng cho lượt biên tập của openai-2pass/google-2pass. Để trống = dùng lại
# TRANSLATE_MODEL.
TRANSLATE_POLISH_MODEL=
GLOSSARY_FILE=glossary.json
# Có dùng glossary hay không, ở bất kỳ dạng nào. false (= cờ --no-glossary) là model
# không nhận placeholder lẫn bảng thuật ngữ, tự bịa mặt chữ.
GLOSSARY=true
# CƠ CHẾ đưa glossary tới model. true = bọc thuật ngữ bằng placeholder ⟦n⟧ trước khi
# dịch. false (= cờ --no-protect) là text đi nguyên vẹn, thuật ngữ khớp vẫn được gửi
# vào prompt dưới dạng bảng "Hán tự = bản dịch" — tắt riêng cơ chế mà vẫn giữ tri
# thức thuật ngữ, để A/B xem placeholder có tự làm hỏng bản dịch không.
GLOSSARY_PROTECT=true
# Câu mồi phát hiện Google đã tụt xuống model đời cũ. Nó được chèn vào cùng payload
# thật (hỏi riêng sẽ đốt mất suất model tốt). Bản dịch chứa TRANSLATE_CANARY_BAD
# nghĩa là đang bị model kém.
TRANSLATE_CANARY=杀人放火金腰带,果然成不起我。
TRANSLATE_CANARY_BAD=đai vàng
TRANSLATE_COMPARE_PROVIDERS=openai,deepseek,qwen,google-web
TRANSLATE_COMPARE_PREVIEW=10

# ── Browser ───────────────────────────────────────────────────
# KHÔNG để true nếu không cần: headless thuần dễ bị Douyin phát hiện
HEADLESS=false
BROWSER_PROFILE_DIR=.browser-profile

# ── Scraping ──────────────────────────────────────────────────
DATA_DIR=data
# Số vòng scroll liên tiếp không ra thêm video ID mới thì dừng
SCROLL_IDLE_ROUNDS=3
# Chặn trên số vòng scroll, phòng loop vô hạn
SCROLL_MAX_ROUNDS=500
# Chờ tối đa bao lâu cho lazy-load ra video mới sau mỗi lần scroll (ms)
SCROLL_LOAD_TIMEOUT_MS=8000
# Delay ngẫu nhiên giữa các action (ms)
MIN_DELAY_MS=800
MAX_DELAY_MS=2500
DOWNLOAD_RETRIES=3
# Tải kèm video gốc (cần khi muốn ghép audio đã dub trở lại video).
# Video nặng gấp ~45 lần audio — tắt đi nếu chỉ cần transcript.
DOWNLOAD_VIDEO=true
# best = bitrate cao nhất (1080p, ~55MB/video 3.5 phút)
# worst = thấp nhất (540p, ~7MB)
VIDEO_QUALITY=best
# Thời gian chờ bắt được link media của 1 video (ms)
CAPTURE_TIMEOUT_MS=20000
# Số video fetch song song. Đo trên 8 video: tuần tự 9,2s/video → 6/3 còn 3,1s
# → 8/4 còn 2,5s → 12/6 không nhanh thêm (băng thông bão hoà).
# Ghi đè một lần bằng: npm run fetch -- <user_id> --concurrency 8
FETCH_CONCURRENCY=6
# Trần riêng cho số trang Chromium mở cùng lúc (nặng RAM + lộ diện với bot detection).
# Luôn để thấp hơn FETCH_CONCURRENCY; phần tải file không tính vào trần này.
CAPTURE_CONCURRENCY=3
# Thời gian chờ danh sách video render ở bước collect (ms).
# Cũng là khoảng thời gian để xử lý captcha/đăng nhập thủ công.
PAGE_READY_TIMEOUT_MS=120000

# ── Logging ───────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Mọi lời gọi API (STT, diarize, dịch, TTS, tải media) đều in request + response qua
# src/apiLog.js. Mức mặc định là `debug` nên với LOG_LEVEL=info ở trên thì chúng ẩn
# đi — chạy batch hàng trăm video không bị ngập log.
#   - Muốn soát từng lời gọi: LOG_LEVEL=debug (bật debug của mọi module), hoặc
#     API_LOG_LEVEL=info (chỉ nổi riêng phần API lên).
API_LOG_LEVEL=debug
# Trần độ dài mỗi chuỗi thường trong log API; 0 = in đủ không cắt. Prompt dịch dài
# nhất cũng chỉ vài nghìn ký tự nên mặc định này không đụng tới nội dung cần soát.
# Riêng khối base64 (audio của qwen-asr / voice-judge / voice-enrollment) LUÔN bị cắt
# còn 48 ký tự đầu bất kể giá trị ở đây — 1.6 triệu ký tự base64 phủ kín màn hình mà
# chẳng ai đọc.
API_LOG_MAX_CHARS=20000
